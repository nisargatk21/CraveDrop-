<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <servlet>
    <servlet-name>CraveDropFrontController</servlet-name>
    <servlet-class>com.cravedrop.web.FrontController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CraveDropFrontController</servlet-name>
    <url-pattern>/app/*</url-pattern>
  </servlet-mapping>
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
</web-app>
