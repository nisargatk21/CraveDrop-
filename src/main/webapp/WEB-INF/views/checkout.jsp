<%@ include file="_h.jspf" %>
<div id="main" role="main">
<div class="wrap checkout-page"><a class="back-link" href="${ctx}/app/cart">&#8592; Back to cart</a><h1>Checkout</h1><div class="checkout-grid"><section class="panel"><h2>Order Summary</h2><c:forEach var="l" items="${lines}"><div class="summary-line"><span>${l.qty} &times; <c:out value="${l.item.name}"/></span><b>&#8377;<fmt:formatNumber value="${l.total}" pattern="#,##0.00"/></b></div></c:forEach><div class="summary-line"><span>Item Total</span><b>&#8377;<fmt:formatNumber value="${subtotal}" pattern="#,##0.00"/></b></div><div class="summary-line muted"><span>GST (5%)</span><span>&#8377;<fmt:formatNumber value="${gst}" pattern="#,##0.00"/></span></div><div class="summary-line muted"><span>Delivery Partner Fee</span><span>&#8377;<fmt:formatNumber value="${deliveryFee}" pattern="#,##0.00"/></span></div><div class="summary-line muted"><span>Platform Fee</span><span>&#8377;<fmt:formatNumber value="${platformFee}" pattern="#,##0.00"/></span></div><div class="summary-line grand"><span>Grand Total</span><b>&#8377;<fmt:formatNumber value="${total}" pattern="#,##0.00"/></b></div></section>
<section class="panel"><h2>Delivery Details</h2><c:if test="${not empty error}"><p class="msg err" role="alert"><c:out value="${error}"/></p></c:if><form method="post" action="${ctx}/app/checkout" data-busy><label for="full-name">Full Name</label><input id="full-name" value="${fn:escapeXml(user.name)}" readonly><label for="phone">Phone Number</label><input id="phone" name="phone" required pattern="\d{10}" inputmode="numeric" value="${fn:escapeXml(empty param.phone?user.phone:param.phone)}"><label for="address">Delivery Address</label><textarea id="address" name="address" rows="3" required><c:out value="${param.address}"/></textarea><label for="payment">Payment Mode</label><select id="payment" name="payment"><c:forEach var="m" items="${payments}"><option value="${fn:escapeXml(m)}" ${param.payment==m?'selected':''}><c:out value="${m}"/></option></c:forEach></select><button class="btn wide" type="submit">Place Order &middot; &#8377;<fmt:formatNumber value="${total}" pattern="#,##0.00"/></button></form></section></div></div>
</div>
<%@ include file="_f.jspf" %>

