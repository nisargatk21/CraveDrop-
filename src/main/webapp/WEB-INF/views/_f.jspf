<footer class="foot">&copy; CraveDrop &middot; Fresh food, fast.</footer>
<script>document.querySelectorAll('form[data-busy]').forEach(f=>f.addEventListener('submit',()=>{const b=f.querySelector('button[type=submit]');if(b){setTimeout(()=>{b.disabled=true;b.textContent='Please wait…'},0)}}));document.querySelectorAll('[data-profile-menu]').forEach(menu=>{const trigger=menu.querySelector('.profile-trigger');const panel=menu.querySelector('.profile-dropdown');const close=()=>{panel.hidden=true;trigger.setAttribute('aria-expanded','false')};trigger.addEventListener('click',()=>{const open=panel.hidden;panel.hidden=!open;trigger.setAttribute('aria-expanded',String(open))});document.addEventListener('click',e=>{if(!menu.contains(e.target))close()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){close();trigger.focus()}})})</script>
<script>(()=>{const ctx='${ctx}',feedback=document.querySelector('[data-menu-feedback]');const updateCart=data=>{document.querySelectorAll('[data-cart-count]').forEach(n=>n.textContent=data.count);const bar=document.querySelector('[data-floating-cart]');if(bar){bar.hidden=data.count<1;bar.querySelector('[data-floating-count]').textContent=data.count;bar.querySelector('[data-floating-total]').textContent=Number(data.subtotal).toFixed(2)}};const initialBar=document.querySelector('[data-floating-cart]');if(initialBar)initialBar.hidden=Number(document.querySelector('[data-cart-count]')?.textContent||0)<1;const send=async(form,url,body)=>{const response=await fetch(url,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json','Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:new URLSearchParams(body||new FormData(form))});const data=await response.json();if(data.count!==undefined)updateCart(data);if(!response.ok||!data.ok)throw new Error(data.message||'Could not update the cart.');return data};document.querySelectorAll('[data-cart-form]').forEach(form=>form.addEventListener('submit',async event=>{event.preventDefault();const action=form.closest('[data-menu-action]'),button=form.querySelector('button');button.disabled=true;try{await send(form,form.action);const stepper=action.querySelector('[data-menu-stepper]');action.querySelector('.menu-add').classList.add('is-hidden');stepper.classList.remove('is-hidden');stepper.querySelector('[data-item-qty]').textContent='1';if(feedback)feedback.textContent='Added to cart.'}catch(error){if(feedback)feedback.textContent=error.message;else alert(error.message)}finally{button.disabled=false}}));document.querySelectorAll('[data-menu-action] [data-qty-step]').forEach(button=>button.addEventListener('click',async()=>{const action=button.closest('[data-menu-action]'),stepper=action.querySelector('[data-menu-stepper]'),qtyNode=stepper.querySelector('[data-item-qty]'),next=Math.max(0,Math.min(20,Number(qtyNode.textContent)+Number(button.dataset.qtyStep)));if(next===Number(qtyNode.textContent))return;button.disabled=true;try{await send(null,ctx+'/app/cart/set',{id:action.dataset.itemId,qty:next});qtyNode.textContent=String(next);if(next===0){stepper.classList.add('is-hidden');action.querySelector('.menu-add').classList.remove('is-hidden')}if(feedback)feedback.textContent='Cart updated.'}catch(error){if(feedback)feedback.textContent=error.message;else alert(error.message)}finally{button.disabled=false}}));document.querySelectorAll('[data-favorite-form]').forEach(form=>form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button'),label=form.querySelector('[data-favorite-label]');button.disabled=true;try{const data=await send(form,form.action);button.classList.toggle('is-saved',data.saved);button.setAttribute('aria-pressed',String(data.saved));if(label)label.textContent=data.saved?'Saved':'Save dish';if(form.hasAttribute('data-saved-item')&&!data.saved){form.closest('.saved-card').remove();if(!document.querySelector('.saved-card'))location.reload()}if(feedback)feedback.textContent=data.message}catch(error){if(error.message==='Sign in to save dishes.')location.href=ctx+'/app/login?next=/app/wishlist';else if(feedback)feedback.textContent=error.message;else alert(error.message)}finally{button.disabled=false}}))})();</script></body></html>

