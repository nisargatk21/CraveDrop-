<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CraveDrop</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&amp;family=Poppins:wght@400;500;600;700;800&amp;display=swap"><link rel="stylesheet" href="${ctx}/css/style.css?v=13"></head>
<body class="${bodyClass}"><a class="skip" href="#main">Skip to content</a>
<header class="nav"><a class="brand" href="${ctx}/app/home"><span class="brand-mark">&#10022;</span><span>Crave<span>Drop</span></span></a>
<div class="links"><a href="${ctx}/app/home">Home</a><a href="${ctx}/app/restaurants">Restaurants</a><c:if test="${not empty user}"><a class="wishlist-nav" href="${ctx}/app/wishlist">&#9829; Saved</a></c:if><a class="cart-link" href="${ctx}/app/cart"><span class="cart-icon">&#128722;</span> Cart <b class="cart-count" data-cart-count>${cartCount}</b></a>
<c:choose><c:when test="${not empty user}"><div class="profile-menu" data-profile-menu><button class="profile-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="profile-dropdown"><span class="profile-person" aria-hidden="true">&#128100;</span> Profile <span class="profile-caret" aria-hidden="true">&#8964;</span></button><div class="profile-dropdown" id="profile-dropdown" hidden="hidden"><div class="profile-summary"><strong><c:out value="${user.name}"/></strong><span><c:out value="${user.email}"/></span></div><a href="${ctx}/app/dashboard"><span class="drop-icon" aria-hidden="true">&#9638;</span>Customer dashboard</a><c:if test="${user.role=='admin'}"><a href="${ctx}/app/admin"><span class="drop-icon" aria-hidden="true">&#9881;</span>Admin dashboard</a></c:if><a href="${ctx}/app/wishlist"><span class="drop-icon" aria-hidden="true">&#9829;</span>Saved dishes</a><a href="${ctx}/app/orders"><span class="drop-icon" aria-hidden="true">&#128722;</span>My Orders</a><a href="${ctx}/app/password"><span class="drop-icon" aria-hidden="true">&#128273;</span>Change password</a><a href="${ctx}/app/logout"><span class="drop-icon" aria-hidden="true">&#8618;</span>Logout</a></div></div></c:when>
<c:otherwise><a class="profile-link" href="${ctx}/app/login"><span aria-hidden="true">&#128100;</span> Profile</a></c:otherwise></c:choose></div></header>
<a class="floating-cart" data-floating-cart href="${ctx}/app/cart" hidden="hidden"><span class="floating-cart-icon">&#128722;</span><span><strong><b data-floating-count>${cartCount}</b> item(s) in cart</strong><small>View your order</small></span><strong class="floating-cart-total">&#8377;<span data-floating-total><fmt:formatNumber value="${cartSubtotal}" pattern="#,##0.00"/></span> <span aria-hidden="true">&#8594;</span></strong></a>


